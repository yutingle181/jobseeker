server/src/main/resources/static/assets/
server/src/main/resources/static/index.html

# IDE
.idea/
*.iml
.vscode/
.project
.classpath

# Local maven settings (machine-specific paths, generated from template)
**/.mvn/local-settings.xml

# OS
.DS_Store
Thumbs.db

# 本地产物 / 备份（不入库）
server/data/
.codebuddy/
docs/portfolio/**/*.old.*
