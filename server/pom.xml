<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.jobseeker</groupId>
    <artifactId>jobseeker-server</artifactId>
    <version>0.3.0</version>
    <name>jobseeker-server</name>
    <description>求职辅助软件后端：承接 Agent 之外的业务能力</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <!-- 钉死 Flyway 版本，不让它跟着 Spring Boot 的 BOM 漂移。

             本机 MySQL 已于 2026-10-17 从 5.7 升级到 8.0.28（in-place upgrade ✓✓
             —— 三个库、11 张表、行数逐表核对一致 ✓✓），因此这条版本约束的**原始动机已消失**：
             · Flyway 社区版对 MySQL 5.7 的限制比想象中早得多 ✗ —— 实测 9.0.1 / 9.16.3 /
               9.22.3 **全部**报 "MySQL 5.7 is no longer supported by Flyway Community Edition" ✓✗
             · 升级到 8.0 后，9.22.3（Spring Boot 3.2.5 默认版本 ✓）开箱可用 ✓✓

             但**仍然钉版本**，理由换成了更普适的一条：引入带"版本-平台支持矩阵"的工具时，
             版本不能默默跟着 BOM 漂 ✗ —— 今天换成需要更老 MySQL 的组件时，
             BOM 一升环境就起不来 ✓✗。显式钉住，意图可查 ✓。

             顺带记一条原则（这次的真教训）：**别让一个工具反过来逼着所有人升级数据库** ✗ ——
             当时若盲目追新到 10.x，等于给项目加了"必须 MySQL 8.0+"的隐性约束，
             而 docker-compose 里明明是 8.0、本机却是 5.7，这种漂移早就存在，只是没被暴露 ✓。 -->
        <flyway.version>9.22.3</flyway.version>
        <jjwt.version>0.13.0</jjwt.version>
        <okhttp.version>4.12.0</okhttp.version>
        <lombok.version>1.18.48</lombok.version>
        <!--
            默认构建输出目录。
            - CI / Linux / macOS：保持在项目内 target，便于 upload-artifact。
            - 本机 Windows（D: 盘受 safe-delete 过滤驱动影响，maven-resources-plugin
              的「临时文件+rename」原子复制会触发 AccessDeniedException）：
              由 windows  profile 把资源输出临时改到 C:，编译产物仍留在项目同盘 target。
        -->
        <build.dir>${project.basedir}/target</build.dir>
        <resources.dir>${build.dir}/classes</resources.dir>
    </properties>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 密码加密（BCrypt） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- 数据访问 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 数据库迁移：把「改表结构靠人手执行 SQL」变成「启动时按版本自动执行」。

             为什么需要它（2026-10-16 实测）：
             仓库里有 schema.sql（全量建表）+ 三个手工增量脚本
             （add_delivery_exam_done / add_delivery_deadline_url / add_list_indexes）。
             手工方案的真实问题不是"麻烦"，而是**状态不可查**：本机库上三个脚本都已执行，
             但**从代码和 Git 里完全看不出来**——只有连上库逐个查列才知道。
             文件名与实际列名还不一致（add_delivery_deadline_url 实际加的是
             exam_deadline + apply_url），靠文件名推断更会出错。

             Flyway 的取舍：
             · 迁移文件带版本号，Flyway 记在 flyway_schema_history 表里，谁执行过一目了然；
             · **baseline-on-migrate**：已有库只标版本不重跑（数据零改动，零风险）；
             · 全新库则从 V1 顺序执行，最终结构与老库**完全一致**（这是手工方案做不到的）。

             注意：Flyway 9+ 把各数据库的支持拆成独立模块，MySQL 必须显式加 flyway-mysql，
             否则启动报 "Unsupported Database: MySQL 5.7"。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <!-- 鉴权 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- HTTP 客户端（调用 Python Agent） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-sse</artifactId>
            <version>${okhttp.version}</version>
        </dependency>

        <!--
            Redis（缓存 / 分布式锁 / 限流三件套的载体）。
            默认 agent.redis.enabled=false：此时 RedisConfig 不装配、不建连接池，
            服务在「没装 Redis」的机器上照常启动并自动降级为进程内实现（见 cache/ 与 lock/）。
            连接池走 commons-pool2；Lettuce 本身随 starter-data-redis 带入。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- 工具 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 使用阿里云镜像加速依赖下载。 -->
    <repositories>
        <repository>
            <id>aliyun-central</id>
            <name>aliyun central</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>aliyun-plugin</id>
            <name>aliyun plugin</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <!-- build.dir 默认指向项目内 target（CI / Linux / macOS 通用）。
             Windows 本地若受 safe-delete 过滤驱动影响，由 windows profile 把资源输出改到 C:，
             编译产物仍留在与源码同盘的 target，避免 maven-compiler-plugin 跨盘 relativize 报错。 -->
        <directory>${build.dir}</directory>

        <finalName>jobseeker-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>17</version>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <outputDirectory>${resources.dir}</outputDirectory>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <fork>true</fork>
                    <!-- 显式声明注解处理器，确保 Lombok 生效 -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    <additionalClasspathElements>
                        <additionalClasspathElement>${resources.dir}</additionalClasspathElement>
                    </additionalClasspathElements>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>windows-safe-delete</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <!-- Windows 本地：maven-resources-plugin 的临时文件+rename 原子复制
                     在 D: 盘会被 safe-delete 过滤驱动拦截，改为输出到 C:。
                     编译产物仍在项目同盘 target，避免 compiler Path.relativize 跨盘问题。 -->
                <resources.dir>C:/jobseeker-target/classes</resources.dir>
            </properties>
        </profile>
    </profiles>
</project>
